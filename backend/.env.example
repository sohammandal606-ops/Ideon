# Copy this file to .env and replace every placeholder with your project values.
DATABASE_URL=postgresql+asyncpg://postgres:<database-password>@db.<project-ref>.supabase.co:5432/postgres
SUPABASE_URL=https://<project-ref>.supabase.co
# Use a server-only Supabase key. Never expose this value to the frontend.
SUPABASE_SECRET_KEY=<supabase-server-key>

MISTRAL_API_KEY=<your-mistral-api-key>
MISTRAL_MODEL=mistral-small-latest
MISTRAL_TEMPERATURE=0.2

# Agent-specific Mistral API Keys (Each agent can use its own API key and model)
MISTRAL_API_KEY_IDEA_VALIDATOR=<mistral-key-for-idea-validator>
MISTRAL_MODEL_IDEA_VALIDATOR=mistral-small-latest

MISTRAL_API_KEY_MARKET_RESEARCH=<mistral-key-for-market-research>
MISTRAL_MODEL_MARKET_RESEARCH=mistral-small-latest

MISTRAL_API_KEY_COMPETITOR_ANALYSIS=<mistral-key-for-competitor-analysis>
MISTRAL_MODEL_COMPETITOR_ANALYSIS=mistral-small-latest

MISTRAL_API_KEY_BUSINESS_MODEL=<mistral-key-for-business-model>
MISTRAL_MODEL_BUSINESS_MODEL=mistral-small-latest

MISTRAL_API_KEY_FINANCIAL_ANALYSIS=<mistral-key-for-financial-analysis>
MISTRAL_MODEL_FINANCIAL_ANALYSIS=mistral-small-latest

MISTRAL_API_KEY_MVP_PLAN=<mistral-key-for-mvp-plan>
MISTRAL_MODEL_MVP_PLAN=mistral-small-latest

MISTRAL_API_KEY_GTM_STRATEGY=<mistral-key-for-gtm-strategy>
MISTRAL_MODEL_GTM_STRATEGY=mistral-small-latest

MISTRAL_API_KEY_FINAL_VERDICT=<mistral-key-for-final-verdict>
MISTRAL_MODEL_FINAL_VERDICT=mistral-large-latest

MISTRAL_API_KEY_RESEARCH=<mistral-key-for-web-research>
MISTRAL_MODEL_RESEARCH=mistral-small-latest