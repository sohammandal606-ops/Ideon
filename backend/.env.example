# Copy this file to .env and replace every placeholder with your project values.
DATABASE_URL=postgresql+asyncpg://postgres:<database-password>@db.<project-ref>.supabase.co:5432/postgres
SUPABASE_URL=https://<project-ref>.supabase.co
# Use a server-only Supabase key. Never expose this value to the frontend.
SUPABASE_SECRET_KEY=<supabase-server-key>


MISTRAL_API_KEY=<your actual mistral api key>
MISTRAL_MODEL=<mistral model>
MISTRAL_TEMPERATURE=<temparetur>